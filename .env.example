# ── App (required to run locally) ──

# TMDB — movie data (get one at https://www.themoviedb.org/settings/api)
# Use a "Read Access Token" (v4 auth), not the v3 API key
TMDB_READ_ACCESS_TOKEN=

# Supabase — database + auth (project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Server-side scripts only (seeding, migrations, exports) ──

SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ── Data pipeline only (not needed to run the app) ──

# Anthropic — mood classifier batches (scripts/mood-classifier)
ANTHROPIC_API_KEY=
